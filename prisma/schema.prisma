// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())
  username String @unique
  email String @unique
  hash_password String

  created_at DateTime @default(now())

  profiles Profile[]
}

enum ProfileType {
  STANDARD
  PRIVATE
}

enum ProfileColors {
  BLUE
  CYAN
  GREEN
  ORANGE
  RED
  PURPLE
}

model Profile {
  id String @id @default(cuid())
  name String @unique
  user_id String
  password String?
  type ProfileType @default(STANDARD)
  color ProfileColors @default(BLUE)

  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  integrations Integration[]
  communications Communication[]
  searches SearchHistory[]
}

enum IntegrationType {
  GMAIL
  TELEGRAM
}

enum SyncStatus {
  IDLE
  SYNCING
  SUCCESS
  FAILED
}

model Integration {
  id String @id @default(cuid())

  profileID String
  profile Profile @relation(fields: [profileID], references: [id])

  communications Communication[]
  isActive Boolean @default(true)

  type IntegrationType

  accessToken String?
  refreshToken String?

  syncStatus SyncStatus @default(IDLE)
  lastSyncedAt DateTime?

  gmailHistoryId String?

  metadata Json?

  created_at DateTime @default(now())
}

enum CommunicationType {
  EMAIL
  TELEGRAM_MESSAGE
}

model Communication {
  id String @id @default(cuid())

  profileID String
  profile Profile @relation(fields: [profileID], references: [id])

  integrationID String
  integration Integration @relation(fields: [integrationID], references: [id])

  type CommunicationType

  externalID String?

  sender String
  content String
  metadata Json?

  sent_at DateTime

  created_at DateTime @default(now())

  chunks CommunicationChunk[]

  @@unique([integrationID, externalID])
}

model CommunicationChunk {
  id String @id @default(cuid())

  communicationID String
  communication Communication @relation(fields: [communicationID], references: [id])

  chunkIndex Int
  content String

  embedding Embedding?

  created_at DateTime @default(now())

  @@unique([communicationID, chunkIndex])
}

enum VectorModel {
  openai
  local_minilm
}

model Embedding {
  id String @id @default(cuid())

  chunkID String @unique
  chunk CommunicationChunk @relation(fields: [chunkID], references: [id])

  vector Unsupported("vector(384)")

  model VectorModel

  created_at DateTime @default(now())
}

model SearchHistory {
  id String @id @default(cuid())

  profileID String
  profile Profile @relation(fields: [profileID], references: [id])

  query String
  results Json

  created_at DateTime @default(now())
}
